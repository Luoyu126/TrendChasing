# Copy to rsshub.env; insert the Cookie header from your own logged-in
# xiaohongshu.com browser request. Do not share or commit the real file.
XIAOHONGSHU_COOKIE=
# Zhihu request Cookie; keep real credentials only in rsshub.env.
ZHIHU_COOKIES=
# Only the auth_token Cookie value, not the entire Twitter Cookie header.
TWITTER_AUTH_TOKEN=
